GOOGLE_API_KEY=
# modelos Gemini, em ordem de fallback (separados por vírgula)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# embeddings (vector(1536) in Postgres; changing it means re-embedding everything)
EMBED_MODEL=gemini-embedding-2
# free: espaça as chamadas em 60/FREE_TIER_RPM s | fast: só reage a 429
LLM_MODE=free
FREE_TIER_RPM=15
# tentativas por chamada, alternando entre os modelos
LLM_MAX_ATTEMPTS=8
# e-mails por chamada de classificação
CLASSIFY_BATCH_SIZE=25
POSTGRES_PASSWORD=troque-esta-senha
# formato: projects/<project_id>/topics/<nome-do-topico>
GMAIL_PUBSUB_TOPIC=
# opcional: se definido, o endpoint exige ?token=<valor>
WEBHOOK_TOKEN=
# UID/GID do usuário dono de ./secrets no host (`id -u`, `id -g`); padrão 1000
APP_UID=1000
APP_GID=1000

# --- painel / API autenticada ---
# JWT_SECRET: >= 32 caracteres aleatórios (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
# APP_SECRET: chave Fernet (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
APP_SECRET=
# origem do painel (sem barra no fim)
APP_ORIGIN=https://example.org
# production: desliga /docs e /openapi.json
APP_ENV=production
# proxies confiáveis para X-Forwarded-For (padrão: 127.0.0.1/32,172.16.0.0/12)
# TRUSTED_PROXIES=
